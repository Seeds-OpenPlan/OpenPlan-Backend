# OpenPlan 운영 배포용 환경변수 템플릿
#
# 서버에서 `cp .env.prod.example .env` 한 뒤 값을 채운다.
# 🔴 채운 .env 는 절대 커밋하지 않는다(.gitignore 확인).
#
# 개발용 .env.example 과 다른 점:
#   · postgres 컨테이너 변수(POSTGRES_*) 없음 — DB는 RDS다
#   · DB_PORT 가 5433(로컬 매핑) 이 아니라 5432(RDS 기본)
#   · SPRING_PROFILES_ACTIVE 는 compose 가 prod 로 강제하므로 여기서 정하지 않는다

# ── 데이터베이스 (RDS) ───────────────────────────────────────────────────────
# 엔드포인트는 RDS 콘솔 > 연결 & 보안 > 엔드포인트. 포트는 붙이지 않는다.
DB_HOST=openplan-db.xxxxxxxx.ap-northeast-3.rds.amazonaws.com
DB_PORT=5432
DB_NAME=openplan
DB_USERNAME=openplan
# RDS 생성 시 직접 입력한 마스터 비밀번호
DB_PASSWORD=

# ── 인증 ─────────────────────────────────────────────────────────────────────
# 비우면 JWT 서명 키가 없어 인증이 뜨지 않는다. 서버에서 생성 권장:
#   openssl rand -base64 48
JWT_SECRET=

# ── 주소 ─────────────────────────────────────────────────────────────────────
# 단일 오리진이므로 둘 다 같은 호스트를 가리킨다. <EC2_PUBLIC_IP> 를 실제 IP로 바꾼다.
# 메일 본문의 인증 링크와 OAuth 리다이렉트가 이 값을 쓴다 — 틀리면 링크가 로컬을 가리킨다.
APP_BASE_URL=http://<EC2_PUBLIC_IP>
API_BASE_URL=http://<EC2_PUBLIC_IP>/api

# ── 메일 (Gmail SMTP) ────────────────────────────────────────────────────────
# SES를 쓸 수 없어 Gmail SMTP로 확정됨. MAIL_PASSWORD 는 구글 계정 로그인 비밀번호가
# 아니라 2단계 인증 후 발급하는 "앱 비밀번호"(16자)다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── 소셜 로그인 ──────────────────────────────────────────────────────────────
# 각 개발자 콘솔에서 리다이렉트 URI 를 http://<EC2_PUBLIC_IP>/api/... 로 등록한 뒤에야
# 동작한다. 등록 전까지 소셜 3종은 실패한다(AWS가 아니라 각 사 콘솔에서 하는 작업).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
