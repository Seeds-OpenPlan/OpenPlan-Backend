# OpenPlan — CD 감시자 (타이머가 부른다. 이 유닛 자체는 enable 하지 않는다)
[Unit]
Description=OpenPlan CD — 원격 브랜치가 바뀌면 재배포한다
# 네트워크가 없으면 ls-remote 가 실패한다. 부팅 직후 헛도는 것을 막는다.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# 🔴 __USER__·__HOME__·__APP_DIR__ 는 install-cd.sh 가 설치할 때 실제 값으로 채운다 — 이 파일을
#    그대로 /etc/systemd/system 에 복사하면 안 된다. EC2 는 ec2-user, GCP 는 콘솔 SSH 계정 이름이라
#    사용자 이름을 박아 두면 서버를 옮기는 순간 CD 가 "사용자 없음" 으로 멈춘다.
User=__USER__
# bootstrap.sh 가 sudo 를 쓴다. AL2023 의 ec2-user · GCP Ubuntu 의 SSH 계정 둘 다 NOPASSWD 다.
Environment=HOME=__HOME__
WorkingDirectory=__APP_DIR__
ExecStart=/bin/bash __APP_DIR__/deploy/cd-watch.sh

# 🔴 타임아웃을 넉넉히 준다. t3.medium 에서 npm ci + vite build + gradle build 를
#    하면 10분을 넘길 수 있다. 여기서 끊기면 이미지가 반만 구워진 채
#    컨테이너가 뜨는 최악의 상태가 된다. (AI 는 아직 이 배포에 포함되지 않는다 —
#    bootstrap.sh·docker-compose.prod.yml 참고.)
TimeoutStartSec=45min

# 로그는 journal 로 간다: journalctl -u openplan-cd.service -n 100
StandardOutput=journal
StandardError=journal
