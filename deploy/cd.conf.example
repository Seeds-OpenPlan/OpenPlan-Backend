# OpenPlan — CD 설정 (서버의 ~/openplan/cd.conf 로 복사해 쓴다)
#
# 🔴 이 파일이 존재하는 이유가 곧 CD 를 넣는 이유다.
#    배포 대상 브랜치를 명령줄로만 넘기면 그 값은 **서버 어디에도 남지 않는다.**
#    그러면 다음 사람이 `bash deploy/bootstrap.sh` 만 쳤을 때 무엇이 올라갈지
#    아무도 모르고, 실제 배포분과 다르면 기능이 조용히 사라진다 — 기동 실패가
#    아니라 폴백이라 화면으로는 안 보인다(D-69).
#
#    배포 대상 브랜치는 기억이 아니라 파일에 있어야 한다.
#
#    🔴 이 파일을 고쳐도 서버의 cd.conf 는 안 바뀐다(이건 예시다). 실제 값은
#       bootstrap.sh 7단계가 **방금 배포한 것으로** 매번 맞춘다.

# ── 배포 대상 브랜치 ─────────────────────────────────────────────────────────
BE_BRANCH=main
FE_BRANCH=main
AI_BRANCH=main

# ── 저장소 ───────────────────────────────────────────────────────────────────
# 세 저장소 모두 public 이라 자격증명이 필요 없다. CD 에 GitHub 토큰을 두지
# 않는 이유이기도 하다 — 넣을 자격증명이 없으면 D-64(주입 시점에 검증되지 않는
# 시크릿)가 성립할 자리도 없다.
BE_REPO=https://github.com/Seeds-OpenPlan/OpenPlan-Backend.git
FE_REPO=https://github.com/Seeds-OpenPlan/OpenPlan-Frontend.git
AI_REPO=https://github.com/Seeds-OpenPlan/OpenPlan-AI.git

# ── 동작 ─────────────────────────────────────────────────────────────────────
# 감시만 하고 배포는 하지 않는다(1 이면 SHA 비교 결과만 로그에 남긴다).
# 켜기 전에 며칠 돌려 보고 싶을 때 쓴다.
CD_DRY_RUN=0
