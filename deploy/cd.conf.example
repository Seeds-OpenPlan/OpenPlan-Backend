# OpenPlan — CD 설정 (서버의 ~/openplan/cd.conf 로 복사해 쓴다)
#
# 🔴 이 파일이 존재하는 이유가 곧 CD 를 넣는 이유다.
#    bootstrap.sh 의 BE_BRANCH 기본값은 main 인데, 2026-08-23 이후 서버는
#    deploy/w6-integration 으로 돌고 있다(main 보다 91커밋 앞). 그 값은 그날
#    명령줄로 한 번 넘긴 것이라 **서버 어디에도 남아 있지 않다.**
#    누구든 `bash deploy/bootstrap.sh` 만 치면 백엔드가 91커밋 뒤로 돌아가고
#    ─ AiPlacementAdapter 가 없어 AI 가 사라지고
#    ─ PreferencesController 가 없어 가용시간 저장이 다시 깨진다.
#    둘 다 기동 실패가 아니라 **조용한 폴백**이라 화면으로는 안 보인다(D-69).
#
#    배포 대상 브랜치는 기억이 아니라 파일에 있어야 한다.

# ── 배포 대상 브랜치 ─────────────────────────────────────────────────────────
# 🔴 리뷰가 끝나 열린 PR 8건이 main 에 들어가면 BE_BRANCH 를 main 으로 되돌린다.
#    그때 통합 브랜치(deploy/w6-integration)는 지운다 — 절대 머지하지 않는다(D-67).
BE_BRANCH=deploy/w6-integration
FE_BRANCH=main

# ── 저장소 ───────────────────────────────────────────────────────────────────
# 두 저장소 모두 public 이라 자격증명이 필요 없다. CD 에 GitHub 토큰을 두지
# 않는 이유이기도 하다 — 넣을 자격증명이 없으면 D-64(주입 시점에 검증되지 않는
# 시크릿)가 성립할 자리도 없다.
BE_REPO=https://github.com/Seeds-OpenPlan/OpenPlan-Backend.git
FE_REPO=https://github.com/Seeds-OpenPlan/OpenPlan-Frontend.git

# 🔴 AI_BRANCH/AI_REPO 는 여기 없다 — 일부러다. bootstrap.sh 는 아직 AI 를 배포하지
#    않는다(compose 에 ai 서비스가 없다). AI 저장소 SHA 를 여기 넣고 cd-watch.sh 가
#    추적하면, AI 만 바뀌어도 재배포가 돌고 상태 파일엔 "배포됨"이 찍히지만 실제로는
#    아무것도 안 바뀐다 — 추적과 배포가 어긋난다. AI 를 실제로 배포하게 되면
#    (feat/ai-service-deploy, #40) 그 PR 에서 bootstrap.sh·compose 와 함께 이 값도
#    같이 넣는다.

# ── 동작 ─────────────────────────────────────────────────────────────────────
# 감시만 하고 배포는 하지 않는다(1 이면 SHA 비교 결과만 로그에 남긴다).
# 켜기 전에 며칠 돌려 보고 싶을 때 쓴다.
CD_DRY_RUN=0
