# Database container (PostgreSQL)
POSTGRES_DB=openplan
POSTGRES_USER=openplan
POSTGRES_PASSWORD=openplan1234
POSTGRES_PORT=5433

# Spring profile
SPRING_PROFILES_ACTIVE=local

# Application database connection
DB_HOST=localhost
DB_PORT=5433
DB_NAME=openplan
DB_USERNAME=openplan
DB_PASSWORD=openplan1234

# JWT — HS256 이라 32바이트 이상이어야 하며, 미달이면 서버가 기동하지 않는다.
# 생성: openssl rand -base64 48
# dev-auth 스텁(local 기본)으로 도는 동안에는 읽지 않으므로 비워 둬도 된다.
JWT_SECRET=replace-with-your-local-jwt-secret

# OAuth2 (실제 값은 로컬 .env 에만 — 여기엔 절대 넣지 말 것)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 외부 캘린더 (ST-B1-11) — 제공자 access/refresh 토큰을 AES-GCM 으로 저장할 때 쓰는 대칭키.
# 생성: openssl rand -base64 32   (반드시 32바이트 = base64 44자)
# 비워 두면 기동은 되고 연동 시점에만 실패한다 — 캘린더를 쓰지 않는 로컬을 막지 않기 위함.
# 🔴 한 번 정하면 바꾸지 말 것. 키를 바꾸면 이미 저장된 연동 토큰이 전부 복호 불가가 된다.
EXT_TOKEN_KEY=

# Mail (SMTP) — Gmail 앱 비밀번호 사용 (계정 로그인 비번 아님). 실제 값은 로컬 .env 에만
# 비워 두면 메일을 실제로 보내지 않고 본문을 로그로만 남긴다(MailConfig) — 메일이 필요 없는
# 로컬 작업이 막히지 않게 하기 위함. 운영은 AWS SES(프로덕션 액세스 승인 필요).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 발신 주소. 비우면 MAIL_USERNAME 을 그대로 쓴다(제공자가 인증된 주소만 발신 허용)
MAIL_FROM=
# 앱 주소 — 메일 링크와 OAuth 리다이렉트가 함께 쓴다. W5 배포 시 둘 다 실도메인으로 교체
# 사용자 브라우저가 여는 **프론트 주소**(Vite 개발 서버 기준)
APP_BASE_URL=http://localhost:5173
# **이 서버 주소**. OAuth redirect_uri 가 여기 붙는다 — 제공자 콘솔 등록값과 정확히 같아야 한다
# (등록된 값: http://localhost:8080/api/v1/auth/oauth/{provider}/callback)
API_BASE_URL=http://localhost:8080
