# Database container (PostgreSQL)
POSTGRES_DB=openplan
POSTGRES_USER=openplan
POSTGRES_PASSWORD=openplan1234
POSTGRES_PORT=5433

# Spring profile
SPRING_PROFILES_ACTIVE=local

# Application database connection
DB_HOST=localhost
DB_PORT=5433
DB_NAME=openplan
DB_USERNAME=openplan
DB_PASSWORD=openplan1234

# JWT — HS256 이라 32바이트 이상이어야 하며, 미달이면 서버가 기동하지 않는다.
# 생성: openssl rand -base64 48
# dev-auth 스텁(local 기본)으로 도는 동안에는 읽지 않으므로 비워 둬도 된다.
JWT_SECRET=replace-with-your-local-jwt-secret

# OAuth2 (실제 값은 로컬 .env 에만 — 여기엔 절대 넣지 말 것)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 외부 캘린더 (ST-B1-11) — 제공자 access/refresh 토큰을 AES-GCM 으로 저장할 때 쓰는 대칭키.
# 생성: openssl rand -base64 32   (반드시 32바이트 = base64 44자)
# 비워 두면 기동은 되고 연동 시점에만 실패한다 — 캘린더를 쓰지 않는 로컬을 막지 않기 위함.
# 🔴 한 번 정하면 바꾸지 말 것. 키를 바꾸면 이미 저장된 연동 토큰이 전부 복호 불가가 된다.
EXT_TOKEN_KEY=

# Mail (SMTP) — Gmail 앱 비밀번호 사용 (계정 로그인 비번 아님). 실제 값은 로컬 .env 에만
# 비워 두면 메일을 실제로 보내지 않고 본문을 로그로만 남긴다(MailConfig) — 메일이 필요 없는
# 로컬 작업이 막히지 않게 하기 위함. 운영은 AWS SES(프로덕션 액세스 승인 필요).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 발신 주소. 비우면 MAIL_USERNAME 을 그대로 쓴다(제공자가 인증된 주소만 발신 허용)
MAIL_FROM=
# 앱 주소 — 메일 링크와 OAuth 리다이렉트가 함께 쓴다. W5 배포 시 둘 다 실도메인으로 교체
# 사용자 브라우저가 여는 **프론트 주소**(Vite 개발 서버 기준)
APP_BASE_URL=http://localhost:5173
# **이 서버 주소**. OAuth redirect_uri 가 여기 붙는다 — 제공자 콘솔 등록값과 정확히 같아야 한다
# (등록된 값: http://localhost:8080/api/v1/auth/oauth/{provider}/callback)
API_BASE_URL=http://localhost:8080

# ── AI 계획 초안 서비스 ─────────────────────────────────────
# 🔴 이 키가 없어도 서버는 뜬다. AI 서비스가 503 을 돌려주고 Spring 이 규칙 first-fit 으로
#    폴백한다(Spring↔AI 계약 §4) — 조용히 규칙으로 도는 것이지 오류가 아니다.
#    "AI 를 켰는데 왜 규칙이 도나" 싶으면 여기부터 본다.
#
# 🔴 제공자는 **모델 문자열의 접두사**로 정해진다. 그래서 이 파일의 COMPLEX_MODEL/LIGHT_MODEL 이
#    사실상 제공자 선택이다 — docker-compose.prod.yml 의 기본값(${COMPLEX_MODEL:-groq/...})은
#    **여기 값이 있으면 진다.** compose 가 프로젝트 디렉터리의 .env 를 변수치환에 자동으로 읽고,
#    bootstrap.sh 의 .env 시드는 REQUIRED_KEYS 만 비우는데 모델 키는 거기 없기 때문이다.
#    2026-08-27 리뷰에서 실측: 이 값이 gemini 로 남아 있으면 GROQ_API_KEY 를 채워도
#    모델은 gemini 로 나가고, GEMINI_API_KEY 가 비어 있으면 매 요청 실패 → 규칙 폴백을
#    영구히 반복한다. NFR-029(5초)를 지키려고 Groq 로 갈아탄 것이 신규 배포마다 되돌아온다.
#
# 발급: Groq  https://console.groq.com/keys (카드 불필요)
GROQ_API_KEY=
# 발급: Gemini https://aistudio.google.com/apikey (폴백용 — 무료 티어, draft 실측 10.9초)
GEMINI_API_KEY=
# 모델은 은퇴한다 — 404 "no longer available" 이 나면 값만 갈아 끼운다(코드 무변경).
# 🔴 REASONING_EFFORT 를 모델과 함께 바꿀 것. 허용값이 제공자마다 다르다 —
#    Groq gpt-oss 는 low|medium|high 만 받고 minimal 은 무효라, 안 맞으면
#    **매 호출이 거부되는데 화면은 멀쩡하다**(D-87).
COMPLEX_MODEL=groq/openai/gpt-oss-120b
LIGHT_MODEL=groq/openai/gpt-oss-20b
REASONING_EFFORT=low
# 🔴 1024 로 두면 replan 응답이 char 2062 에서 잘린다(08-24 에 원인 불명으로 하루를 썼다).
MAX_TOKENS=2048
