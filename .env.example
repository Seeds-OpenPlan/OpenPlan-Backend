# Database container (PostgreSQL)
POSTGRES_DB=openplan
POSTGRES_USER=openplan
POSTGRES_PASSWORD=openplan1234
POSTGRES_PORT=5433

# Spring profile
SPRING_PROFILES_ACTIVE=local

# Application database connection
DB_HOST=localhost
DB_PORT=5433
DB_NAME=openplan
DB_USERNAME=openplan
DB_PASSWORD=openplan1234

# JWT — HS256 이라 32바이트 이상이어야 하며, 미달이면 서버가 기동하지 않는다.
# 생성: openssl rand -base64 48
# dev-auth 스텁(local 기본)으로 도는 동안에는 읽지 않으므로 비워 둬도 된다.
JWT_SECRET=replace-with-your-local-jwt-secret

# OAuth2 (실제 값은 로컬 .env 에만 — 여기엔 절대 넣지 말 것)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Mail (SMTP) — Gmail 앱 비밀번호 사용 (계정 로그인 비번 아님). 실제 값은 로컬 .env 에만
# 비워 두면 메일을 실제로 보내지 않고 본문을 로그로만 남긴다(MailConfig) — 메일이 필요 없는
# 로컬 작업이 막히지 않게 하기 위함. 운영은 AWS SES(프로덕션 액세스 승인 필요).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 발신 주소. 비우면 MAIL_USERNAME 을 그대로 쓴다(제공자가 인증된 주소만 발신 허용)
MAIL_FROM=
# 메일 링크의 앞부분 = 사용자 브라우저가 여는 **프론트 주소**(API 주소 아님).
# 기본값은 Vite 개발 서버 기준 — W5 배포 시 실도메인으로 교체
APP_BASE_URL=http://localhost:5173
